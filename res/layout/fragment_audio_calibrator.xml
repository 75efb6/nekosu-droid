<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/frg_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/frgDialogStyleBackground">

    <LinearLayout
        android:id="@+id/frg_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/frgBodyBackgroundDark"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@color/accentPrimary"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp"
            android:text="Audio Calibrator"
            android:textColor="@color/textPrimary"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingTop="4dp"
            android:text="Tap in sync with the beat to calibrate your audio offset"
            android:textColor="@color/textSecondary"
            android:textSize="12sp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/dividerColor"/>

        <!-- Configuration row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Taps:"
                android:textColor="@color/textSecondary"
                android:textSize="13sp"/>

            <Spinner
                android:id="@+id/cal_sample_count_spinner"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:entries="@array/calibrator_sample_counts"
                android:background="@drawable/input_bg"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="BPM:"
                android:textColor="@color/textSecondary"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/cal_bpm_edit"
                android:layout_width="60dp"
                android:layout_height="36dp"
                android:background="@drawable/input_bg"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="3"
                android:text="120"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/textSecondary"
                android:textSize="13sp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/dividerColor"/>

        <!-- State text -->
        <TextView
            android:id="@+id/cal_state_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="16dp"
            android:text="Press Start to begin"
            android:textColor="@color/textSecondary"
            android:textSize="14sp"/>

        <!-- Tap counter -->
        <TextView
            android:id="@+id/cal_count_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="4dp"
            android:textColor="@color/textPrimary"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <!-- Error bar visualization -->
        <ru.nsu.ccfit.zuev.osu.game.CalibratorErrorBarView
            android:id="@+id/cal_error_bar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="12dp"/>

        <!-- Running average -->
        <TextView
            android:id="@+id/cal_average_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="4dp"
            android:textColor="@color/textSecondary"
            android:textSize="12sp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/dividerColor"/>

        <!-- Result card -->
        <LinearLayout
            android:id="@+id/cal_result_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recommended offset"
                android:textColor="@color/textSecondary"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/cal_result_offset_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:textColor="@color/accentPrimary"
                android:textSize="28sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="28dp">

            <Button
                android:id="@+id/cal_start_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/btn_accent"
                android:text="Start"
                android:textAllCaps="true"
                android:textColor="@color/textPrimary"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/cal_apply_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/btn_accent"
                android:text="Apply"
                android:textAllCaps="true"
                android:textColor="@color/textPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"/>

            <Button
                android:id="@+id/cal_retry_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/input_bg"
                android:text="Retry"
                android:textAllCaps="true"
                android:textColor="@color/textPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
