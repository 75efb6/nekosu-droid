<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/frg_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Toggle button top-right -->
    <ImageView
        android:id="@+id/replayToggleButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="8dp"
        android:padding="10dp"
        android:background="@drawable/bg_circle_dark"
        android:src="@drawable/ic_tune"
        android:scaleType="fitCenter"
        android:elevation="8dp"/>

    <!-- Control panel bottom -->
    <LinearLayout
        android:id="@+id/replayControlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="#CC0F0F1A"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <!-- Seek bar row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/replayCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:minWidth="40dp"/>

            <SeekBar
                android:id="@+id/replaySeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:max="1000"
                android:progressTint="#E63E8C"
                android:thumbTint="#E63E8C"/>

            <TextView
                android:id="@+id/replayTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:minWidth="40dp"/>
        </LinearLayout>

        <!-- Controls row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/replayPauseBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_pause"
                android:scaleType="fitCenter"
                android:tint="#FFFFFF"/>

            <ImageView
                android:id="@+id/replaySeekBackBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_rew"
                android:scaleType="fitCenter"
                android:tint="#FFFFFF"/>

            <ImageView
                android:id="@+id/replaySeekFwdBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_ff"
                android:scaleType="fitCenter"
                android:tint="#FFFFFF"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/replaySpeedDownCoarse"
                android:layout_width="36dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="\u00AB"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:id="@+id/replaySpeedDown"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="\u2039"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:id="@+id/replaySpeedText"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="1.00x"
                android:textColor="#E63E8C"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:minWidth="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:id="@+id/replaySpeedUp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="\u203A"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:id="@+id/replaySpeedUpCoarse"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="\u00BB"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackgroundBorderless"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
