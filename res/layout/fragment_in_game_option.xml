<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/frg_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/brightnessPreviewLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/brightnessPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <TextView
            android:id="@+id/brightPreviewText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="#CC000000"
            android:padding="16dp"
            android:textColor="@color/textPrimary"
            android:textSize="28sp"
            android:textStyle="bold"/>
    </RelativeLayout>

    <!-- Panel slides in from the right; handle strip on left edge stays visible -->
    <LinearLayout
        android:id="@+id/fullLayout"
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:orientation="horizontal"
        android:translationX="9999dp">

        <!-- Left handle strip: touch here to toggle panel -->
        <RelativeLayout
            android:id="@+id/frg_header"
            android:layout_width="28dp"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/showMoreButton"
                android:layout_width="28dp"
                android:layout_height="80dp"
                android:layout_centerInParent="true"
                android:gravity="center">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_tune"
                    android:scaleType="fitCenter"/>
            </LinearLayout>

            <!-- Right accent stripe facing the content -->
            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:background="@color/accentPrimary"/>
        </RelativeLayout>

        <!-- Main content -->
        <LinearLayout
            android:id="@+id/optionBody"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/frgBodyBackgroundDark"
            android:clickable="true"
            android:orientation="vertical">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="12dp"
                    android:paddingTop="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="4dp">

                        <CheckBox
                            android:id="@+id/enableStoryboard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:saveEnabled="false"
                            android:text="@string/opt_enableStoryboard_title"
                            android:textColor="@color/textPrimary"
                            android:textSize="13sp"/>

                        <CheckBox
                            android:id="@+id/enableVideo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:saveEnabled="false"
                            android:text="Enable video"
                            android:textColor="@color/textPrimary"
                            android:textSize="13sp"/>

                        <CheckBox
                            android:id="@+id/showScoreboard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:saveEnabled="false"
                            android:text="@string/opt_show_scoreboard_title"
                            android:textColor="@color/textPrimary"
                            android:textSize="13sp"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/dividerColor"/>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="10dp">

                        <TextView
                            android:id="@+id/bg_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:text="@string/opt_bgbrightness_title"
                            android:textColor="@color/textPrimary"
                            android:textSize="13sp"/>

                        <SeekBar
                            android:id="@+id/backgroundBrightnessBar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginHorizontal="8dp"
                            android:layout_toEndOf="@+id/bg_title"
                            android:layout_toStartOf="@+id/bgBrightnessText"
                            android:saveEnabled="false"/>

                        <TextView
                            android:id="@+id/bgBrightnessText"
                            android:layout_width="46dp"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:gravity="end"
                            android:text="25%"
                            android:textColor="@color/textSecondary"
                            android:textSize="12sp"/>
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/dividerColor"/>

                    <RelativeLayout
                        android:id="@+id/speed_modify"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="4dp">

                        <CheckBox
                            android:id="@+id/enableSpeedChange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:saveEnabled="false"
                            android:text="@string/opt_changespeed_title"
                            android:textColor="@color/textPrimary"
                            android:textSize="13sp"/>

                        <SeekBar
                            android:id="@+id/changeSpeedBar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginHorizontal="8dp"
                            android:layout_toEndOf="@+id/enableSpeedChange"
                            android:layout_toStartOf="@+id/changeSpeedText"
                            android:max="30"
                            android:saveEnabled="false"/>

                        <TextView
                            android:id="@+id/changeSpeedText"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:gravity="end"
                            android:text="1.00x"
                            android:textColor="@color/textSecondary"
                            android:textSize="12sp"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp">

                        <CheckBox
                            android:id="@+id/enableNCwhenSpeedChange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:saveEnabled="false"
                            android:text="@string/opt_enablenc_whenspeedchange_title"
                            android:textColor="@color/textPrimary"
                            android:textSize="13sp"/>
                    </RelativeLayout>

                    <View
                        android:id="@+id/force_diffstat_split_view"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/dividerColor"/>

                    <RelativeLayout
                        android:id="@+id/custom_ar_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="4dp">

                        <CheckBox
                            android:id="@+id/custom_ar_toggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:saveEnabled="false"
                            android:text="@string/opt_forcear_title"
                            android:textColor="@color/textPrimary"
                            android:textSize="13sp"/>

                        <SeekBar
                            android:id="@+id/custom_ar_bar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginHorizontal="8dp"
                            android:layout_toEndOf="@+id/custom_ar_toggle"
                            android:layout_toStartOf="@+id/custom_ar_text"
                            android:saveEnabled="false"/>

                        <TextView
                            android:id="@+id/custom_ar_text"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:gravity="end"
                            android:text="AR 9.0"
                            android:textColor="@color/textSecondary"
                            android:textSize="12sp"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/custom_od_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="4dp">

                        <CheckBox
                            android:id="@+id/custom_od_toggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:saveEnabled="false"
                            android:text="Force OD"
                            android:textColor="@color/textPrimary"
                            android:textSize="13sp"/>

                        <SeekBar
                            android:id="@+id/custom_od_bar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginHorizontal="8dp"
                            android:layout_toEndOf="@+id/custom_od_toggle"
                            android:layout_toStartOf="@+id/custom_od_text"
                            android:saveEnabled="false"/>

                        <TextView
                            android:id="@+id/custom_od_text"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:gravity="end"
                            android:text="OD 9.0"
                            android:textColor="@color/textSecondary"
                            android:textSize="12sp"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/custom_cs_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="4dp">

                        <CheckBox
                            android:id="@+id/custom_cs_toggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:saveEnabled="false"
                            android:text="Force CS"
                            android:textColor="@color/textPrimary"
                            android:textSize="13sp"/>

                        <SeekBar
                            android:id="@+id/custom_cs_bar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginHorizontal="8dp"
                            android:layout_toEndOf="@+id/custom_cs_toggle"
                            android:layout_toStartOf="@+id/custom_cs_text"
                            android:max="100"
                            android:saveEnabled="false"/>

                        <TextView
                            android:id="@+id/custom_cs_text"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:gravity="end"
                            android:text="CS 4.0"
                            android:textColor="@color/textSecondary"
                            android:textSize="12sp"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/custom_hp_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <CheckBox
                            android:id="@+id/custom_hp_toggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:saveEnabled="false"
                            android:text="Force HP"
                            android:textColor="@color/textPrimary"
                            android:textSize="13sp"/>

                        <SeekBar
                            android:id="@+id/custom_hp_bar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginHorizontal="8dp"
                            android:layout_toEndOf="@+id/custom_hp_toggle"
                            android:layout_toStartOf="@+id/custom_hp_text"
                            android:max="100"
                            android:saveEnabled="false"/>

                        <TextView
                            android:id="@+id/custom_hp_text"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:gravity="end"
                            android:text="HP 7.0"
                            android:textColor="@color/textSecondary"
                            android:textSize="12sp"/>
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/dividerColor"/>

                    <RelativeLayout
                        android:id="@+id/follow_delay_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="10dp">

                        <TextView
                            android:id="@+id/fl_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:text="@string/opt_flashlight_follow_delay_title"
                            android:textColor="@color/textPrimary"
                            android:textSize="13sp"/>

                        <SeekBar
                            android:id="@+id/flashlightFollowDelayBar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginHorizontal="8dp"
                            android:layout_toEndOf="@+id/fl_title"
                            android:layout_toStartOf="@+id/flashlightFollowDelayText"
                            android:max="100"
                            android:saveEnabled="false"/>

                        <TextView
                            android:id="@+id/flashlightFollowDelayText"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:gravity="end"
                            android:text="0ms"
                            android:textColor="@color/textSecondary"
                            android:textSize="12sp"/>
                    </RelativeLayout>

                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
