<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/frg_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/frgDialogStyleBackground">

    <LinearLayout
        android:id="@+id/fullLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/showMoreButton"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center"
            android:background="@android:color/transparent"/>

        <LinearLayout
            android:id="@+id/optionBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/frgBodyBackgroundDark"
            android:clickable="true"
            android:orientation="vertical"
            android:paddingBottom="28dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@color/accentPrimary"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:paddingHorizontal="20dp"
                android:paddingTop="18dp"
                android:paddingBottom="16dp"
                android:text="BEATMAP OPTIONS"
                android:textColor="@color/textSecondary"
                android:textSize="10sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.08"
                android:text="OFFSET (MS)"
                android:textColor="@color/textSecondary"
                android:textSize="10sp"/>

            <EditText
                android:id="@+id/offsetBox"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/input_bg"
                android:gravity="center"
                android:inputType="numberSigned"
                android:maxLength="5"
                android:padding="12dp"
                android:text="0"
                android:textColor="@color/textPrimary"
                android:textSize="15sp"/>

            <CheckBox
                android:id="@+id/addToFav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="16dp"
                android:saveEnabled="false"
                android:text="@string/menu_properties_tofavs"
                android:textColor="@color/textPrimary"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/manageFavButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/btn_accent"
                android:gravity="center"
                android:text="@string/favorite_manage"
                android:textColor="@color/textPrimary"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/deleteBeatmap"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/btn_danger"
                android:gravity="center"
                android:text="@string/menu_properties_delete"
                android:textColor="@color/textPrimary"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
